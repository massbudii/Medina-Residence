            <tr>
                <td class="text-center fw-bold">TC-14</td>
                <td class="text-center">FR-07</td>
                <td>Fitur 2:<br>Profil Pengguna</td>
                <td>Equivalence Partitioning<br>(Kelas Data Tidak Valid)</td>
                <td>Mengunggah berkas foto profil dengan format ekstensi selain gambar (dokumen .pdf)</td>
                <td class="text-center fw-bold">Pass</td>
            </tr>
            <tr>
                <td class="text-center fw-bold">TC-15</td>
                <td class="text-center">FR-07</td>
                <td>Fitur 2:<br>Profil Pengguna</td>
                <td>Boundary Value Analysis<br>(Di Atas Batas &gt; 2 MB)</td>
                <td>Mengunggah berkas foto profil berformat gambar namun berukuran melebihi batas maksimal 2048 KB (&gt; 2 MB)</td>
                <td class="text-center fw-bold">Pass</td>
            </tr>
            <tr>
                <td class="text-center fw-bold">TC-16</td>
                <td class="text-center">FR-08</td>
                <td>Fitur 2:<br>Profil Pengguna</td>
                <td>Positive Testing &amp;<br>Equivalence Partitioning</td>
                <td>Memperbarui Password Baru pada halaman Profil dengan format valid (minimal 6 karakter, huruf awal kapital, kombinasi huruf dan angka: Mandor123)</td>
                <td class="text-center fw-bold">Pass</td>
            </tr>
            <tr>
                <td class="text-center fw-bold">TC-17</td>
                <td class="text-center">FR-08</td>
                <td>Fitur 2:<br>Profil Pengguna</td>
                <td>Boundary Value Analysis<br>(Batas Minimum - 1 = 5 Karakter)</td>
                <td>Memperbarui Password Baru pada halaman Profil dengan panjang 5 karakter (Mand1 - satu karakter di bawah batas minimal 6 karakter)</td>
                <td class="text-center fw-bold">Pass</td>
            </tr>
            <tr>
                <td class="text-center fw-bold">TC-18</td>
                <td class="text-center">FR-08</td>
                <td>Fitur 2:<br>Profil Pengguna</td>
                <td>Equivalence Partitioning<br>(Pola Regex Tidak Valid)</td>
                <td>Memperbarui Password Baru pada halaman Profil dengan panjang &gt;= 6 karakter tetapi tanpa huruf kapital awal (mandor123) atau tanpa angka (Mandorrr)</td>
                <td class="text-center fw-bold">Pass</td>
            </tr>
            <tr>
                <td class="text-center fw-bold">TC-19</td>
                <td class="text-center">FR-02,<br>FR-07</td>
                <td>Fitur 2:<br>Profil Pengguna</td>
                <td>Exploratory Testing &amp;<br>State Transition</td>
                <td>Percobaan melewati (bypass) Login Guard oleh akun yang belum memiliki foto profil dengan langsung menekan menu Dashboard di sidebar</td>
                <td class="text-center fw-bold">Fail<br>(DEF-02)</td>
            </tr>
            <tr>
                <td class="text-center fw-bold">TC-20</td>
                <td class="text-center">FR-06</td>
                <td>Fitur 2:<br>Profil Pengguna</td>
                <td>Exploratory Testing<br>(Keunikan Data Email)</td>
                <td>Memperbarui alamat Email pada halaman Profil menggunakan alamat email yang sudah terdaftar milik pengguna lain (admin@gmail.com)</td>
                <td class="text-center fw-bold">Fail<br>(DEF-03)</td>
            </tr>

            <!-- FITUR 3: MANAJEMEN DATA USER (TC-21 s.d. TC-30) -->
            <tr>
                <td class="text-center fw-bold">TC-21</td>
                <td class="text-center">FR-08,<br>FR-09</td>
                <td>Fitur 3:<br>Manajemen Data User</td>
                <td>Positive Testing<br>(Alur Normal)</td>
                <td>Menambahkan data User baru oleh Admin dengan seluruh masukan valid (Nama, Email unik, Password: User123, Role: Mandor)</td>
                <td class="text-center fw-bold">Pass</td>
            </tr>
            <tr>
                <td class="text-center fw-bold">TC-22</td>
                <td class="text-center">FR-09</td>
                <td>Fitur 3:<br>Manajemen Data User</td>
                <td>Negative Testing<br>(Kolom Wajib Kosong)</td>
                <td>Menambahkan data User baru dengan mengosongkan seluruh kolom wajib (Nama, Email, Password, dan Role) pada modal Tambah User</td>
                <td class="text-center fw-bold">Pass</td>
            </tr>
            <tr>
                <td class="text-center fw-bold">TC-23</td>
                <td class="text-center">FR-08</td>
                <td>Fitur 3:<br>Manajemen Data User</td>
                <td>Boundary Value Analysis<br>(5 Karakter vs 6 Karakter)</td>
                <td>Pengujian nilai batas panjang Password pada form Tambah User: 5 karakter (User1 - ditolak) dan tepat pada batas 6 karakter (User12 - diterima)</td>
                <td class="text-center fw-bold">Pass</td>
            </tr>
            <tr>
                <td class="text-center fw-bold">TC-24</td>
                <td class="text-center">FR-08</td>
                <td>Fitur 3:<br>Manajemen Data User</td>
                <td>Equivalence Partitioning<br>(Pola Regex Password)</td>
                <td>Menambahkan data User baru dengan password yang tidak diawali huruf kapital (user123) atau tidak mengandung angka (Userrrr)</td>
                <td class="text-center fw-bold">Pass</td>
            </tr>
            <tr>
                <td class="text-center fw-bold">TC-25</td>
                <td class="text-center">FR-09</td>
                <td>Fitur 3:<br>Manajemen Data User</td>
                <td>Positive Testing &amp;<br>Decision Table</td>
                <td>Mengubah data User (Nama, Email, dan Role) oleh Admin melalui modal Edit User dengan mengosongkan kolom Password Opsional</td>
                <td class="text-center fw-bold">Pass</td>
            </tr>
            <tr>
                <td class="text-center fw-bold">TC-26</td>
                <td class="text-center">FR-09</td>
                <td>Fitur 3:<br>Manajemen Data User</td>
                <td>State Transition Testing<br>(Aktif &lt;-&gt; Nonaktif)</td>
                <td>Mengubah status akun User biasa dari Aktif menjadi Nonaktif, kemudian mengaktifkannya kembali dari Nonaktif menjadi Aktif</td>
                <td class="text-center fw-bold">Pass</td>
            </tr>
            <tr>
                <td class="text-center fw-bold">TC-27</td>
                <td class="text-center">FR-09</td>
                <td>Fitur 3:<br>Manajemen Data User</td>
                <td>Decision Table Testing &amp;<br>State Transition Negative</td>
                <td>Percobaan menonaktifkan akun Admin Utama (id = 1) atau menonaktifkan akun diri sendiri yang sedang login</td>
                <td class="text-center fw-bold">Pass</td>
            </tr>
            <tr>
                <td class="text-center fw-bold">TC-28</td>
                <td class="text-center">FR-09</td>
                <td>Fitur 3:<br>Manajemen Data User</td>
                <td>Decision Table Testing<br>(Aturan Hapus User)</td>
                <td>Penghapusan akun User biasa oleh Admin Utama (id = 1) serta pengujian proteksi penolakan hapus terhadap akun Admin Utama</td>
                <td class="text-center fw-bold">Pass</td>
            </tr>
            <tr>
                <td class="text-center fw-bold">TC-29</td>
                <td class="text-center">FR-09</td>
                <td>Fitur 3:<br>Manajemen Data User</td>
                <td>Exploratory Testing<br>(Validasi Email Unik)</td>
                <td>Menambahkan akun User baru menggunakan alamat Email yang sudah terdaftar pada akun pengguna lain di dalam database</td>
                <td class="text-center fw-bold">Fail<br>(DEF-04)</td>
            </tr>
            <tr>
                <td class="text-center fw-bold">TC-30</td>
                <td class="text-center">FR-10,<br>NFR-02</td>
                <td>Fitur 3:<br>Manajemen Data User</td>
                <td>Exploratory Testing &amp;<br>Decision Table (RBAC)</td>
                <td>Percobaan akses paksa (forced browsing) oleh pengguna ber-role Mandor ke URL /user/data-user dan manipulasi data pengguna</td>
                <td class="text-center fw-bold">Fail<br>(DEF-05)</td>
            </tr>
        </tbody>
    </table>

